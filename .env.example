# Copy this file to ".env" and fill in your key. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Everything below is optional: the defaults are shown.
LLM_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
TEMPERATURE=0.1
MAX_TOKENS=500
MAX_UPLOAD_MB=15
